# Gender Reviewer Pipeline — env vars (copy to .env.local and fill in values)

# ---------------------------------------------------------
# Azure Document Intelligence (OCR) — REQUIRED
# ---------------------------------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-resource.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-key-here

# ---------------------------------------------------------
# Azure GPT54 / AI Foundry (LLM extraction) — REQUIRED
# ---------------------------------------------------------
GPT54_API_KEY=your-azure-ai-key
GPT54_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project/openai/v1/responses
AZURE_GPT54_DEPLOYMENT=your-deployment-name
AZURE_GPT54_API_VERSION=your-api-version

# ---------------------------------------------------------
# Vercel Blob (PDF storage) — REQUIRED
# ---------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ---------------------------------------------------------
# Supabase (pipeline state + per-document AI results) — REQUIRED
# ---------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=eyJhbG...  # service role key recommended

# ---------------------------------------------------------
# CORS (optional — defaults to allow all origins)
# ---------------------------------------------------------
# CORS_ORIGINS=https://your-chatbot.example.com,https://your-upload-page.vercel.app

# ---------------------------------------------------------
# Elasticsearch (optional — only needed for legacy sync/admin UI)
# ---------------------------------------------------------
# ES_HOST=http://localhost:9200
# ES_INDEX=documents
# ES_KEYWORD_INDEX=keyword_registry

# ---------------------------------------------------------
# Legacy sources (optional — only if using Airtable/Google Forms sync)
# ---------------------------------------------------------
# AIRTABLE_PAT=pat...
# AIRTABLE_BASE_ID=app...
# AIRTABLE_TABLE_NAME=docs1
# GOOGLE_APPLICATION_CREDENTIALS=.gcp-credentials.json
# GOOGLE_FORM_ID=your-form-id
